<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <!-- ===== Xacro Properties & Parameters ===== -->
  <xacro:property name="pkg_name" value="for_urdf_description"/>
  <xacro:property name="base_z_offset" value="0.098"/>
  <xacro:property name="wheel_radius" value="0.098"/>
  <xacro:property name="wheel_length" value="0.04"/>
  <xacro:property name="wheel_sep_y" value="0.31773"/>
  <xacro:property name="caster_radius" value="0.0757"/>
  <xacro:property name="pi_val" value="3.141592653589793"/>

  <!-- 라이다 오프셋: 앞쪽으로 나온 만큼 lidar_x_offset을 줄여 중심에 맞출 수 있음 -->
  <xacro:property name="lidar_x_offset" value="0.03034"/>
  <xacro:property name="lidar_y_offset" value="-0.00039"/>
  <xacro:property name="lidar_z_offset" value="0.474"/>

  <!-- ===== RViz Materials ===== -->
  <material name="body">
    <color rgba="0.85 0.85 0.88 1.0"/>
  </material>
  <material name="tyre">
    <color rgba="0.12 0.12 0.12 1.0"/>
  </material>
  <material name="caster">
    <color rgba="0.35 0.35 0.38 1.0"/>
  </material>
  <material name="lidar">
    <color rgba="0.10 0.10 0.12 1.0"/>
  </material>

  <!-- ===== Reusable Transmission Macro (ros2_control 확장용) ===== -->
  <xacro:macro name="wheel_transmission" params="prefix joint_name">
    <transmission name="${prefix}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint_name}">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}_motor">
        <mechanicalReduction>1.0</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <!-- ===== Base & Wheels ===== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 ${base_z_offset}"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://${pkg_name}/meshes/new_stl/base_link.stl"/>
      </geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="-0.181 0 0.222"/>
      <geometry>
        <box size="0.494 0.414 0.414"/>
      </geometry>
    </collision>
    <collision>
      <geometry>
        <box size="0.098 0.590 0.098"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.181 0 0.222"/>
      <mass value="10.0"/>
      <inertia ixx="0.28565999999999997" ixy="0" ixz="0" iyy="0.34619333333333335" iyz="0" izz="0.34619333333333335"/>
    </inertial>
  </link>

  <link name="left_wheel_link">
    <visual>
      <geometry>
        <mesh filename="package://${pkg_name}/meshes/new_stl/left_wheel.stl"/>
      </geometry>
      <material name="tyre"/>
    </visual>
    <collision>
      <origin rpy="${pi_val/2} 0 0"/>
      <geometry>
        <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.35"/>
      <inertia ixx="0.0008870166666666668" ixy="0" ixz="0" iyy="0.0016807" iyz="0" izz="0.0008870166666666668"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin rpy="0 0 0" xyz="0 ${wheel_sep_y} 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <xacro:wheel_transmission prefix="left_wheel" joint_name="left_wheel_joint"/>

  <link name="right_wheel_link">
    <visual>
      <geometry>
        <mesh filename="package://${pkg_name}/meshes/new_stl/right_wheel.stl"/>
      </geometry>
      <material name="tyre"/>
    </visual>
    <collision>
      <origin rpy="${pi_val/2} 0 0"/>
      <geometry>
        <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.35"/>
      <inertia ixx="0.0008870166666666668" ixy="0" ixz="0" iyy="0.0016807" iyz="0" izz="0.0008870166666666668"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin rpy="0 0 0" xyz="0 ${-wheel_sep_y} 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <xacro:wheel_transmission prefix="right_wheel" joint_name="right_wheel_joint"/>

  <!-- ===== Rear Caster ===== -->
  <link name="caster_link">
    <visual>
      <geometry>
        <mesh filename="package://${pkg_name}/meshes/new_stl/caster.stl"/>
      </geometry>
      <material name="caster"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.0023225760000000002" ixy="0" ixz="0" iyy="0.0023225760000000002" iyz="0" izz="0.0023225760000000002"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin rpy="0 0 0" xyz="-0.5423 0 -0.0223"/>
  </joint>

  <!-- ===== RPLIDAR A1M8 ===== -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <mesh filename="package://${pkg_name}/meshes/new_stl/lidar.stl"/>
      </geometry>
      <material name="lidar"/>
    </visual>
    <collision>
      <origin xyz="-0.0129 0 -0.0163"/>
      <geometry>
        <box size="0.0973 0.0715 0.051"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0129 0 -0.0163"/>
      <mass value="0.17"/>
      <inertia ixx="0.00010927104166666664" ixy="0" ixz="0" iyy="0.00017096744166666665" iyz="0" izz="0.00020654348333333332"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="${lidar_x_offset} ${lidar_y_offset} ${lidar_z_offset}"/>
  </joint>

  <link name="laser"/>

  <joint name="laser_joint" type="fixed">
    <parent link="lidar_link"/>
    <child link="laser"/>
    <origin rpy="0 0 ${pi_val}" xyz="0 0 0"/>
  </joint>

  <!-- ===== Gazebo Materials & Friction ===== -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="caster_link">
    <material>Gazebo/Zinc</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- ===== Gazebo Differential Drive Plugin ===== -->
  <ros2_control name="DallbaeGazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-15.0</param>
        <param name="max">15.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-15.0</param>
        <param name="max">15.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <!-- 패키지 config 폴더의 controllers.yaml 경로에 맞게 수정 -->
      <parameters>$(find for_urdf_description)/config/controller.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ===== Gazebo 2D LiDAR Plugin ===== -->
  <gazebo reference="laser">
    <sensor name="rplidar_a1m8" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10.0</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-${pi_val}</min_angle>
            <max_angle>${pi_val}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>